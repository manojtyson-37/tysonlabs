# Reviews service (see docs/reviews-service.md)
REVIEWS_DATABASE_URL=            # connect as reviews_app (restricted role), never the owner role
REVIEWS_BASE_URL=https://reviews.tysonlabs.in
REVIEWS_KEK=                     # interim key-encryption key: openssl rand -base64 32 (replace with Cloud KMS)
API_KEY_PEPPER=                  # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://reviews.tysonlabs.in/api/v1/oauth/callback
CRON_SECRET=                     # openssl rand -hex 32; Vercel Cron sends it as a Bearer token
DRAFTS_MODE=                     # empty = built-in reply library (default). 'ai' = Gemini; update privacy and terms pages first
AI_DRAFTS_POLICY_ACK=            # must be 'policy-updated' for AI mode to switch on; set only after the privacy and terms pages are changed
GEMINI_API_KEY=                  # only used when DRAFTS_MODE=ai; paid-tier key (billing enabled)
GEMINI_MODEL=gemini-2.5-flash-lite
