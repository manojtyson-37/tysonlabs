# Reviews service (see docs/reviews-service.md)
REVIEWS_DATABASE_URL=            # connect as reviews_app (restricted role), never the owner role
REVIEWS_BASE_URL=https://reviews.tysonlabs.in
REVIEWS_KEK=                     # interim key-encryption key: openssl rand -base64 32 (replace with Cloud KMS)
API_KEY_PEPPER=                  # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://reviews.tysonlabs.in/api/v1/oauth/callback
CRON_SECRET=                     # openssl rand -hex 32; Vercel Cron sends it as a Bearer token
DRAFTS_MODE=                     # empty = built-in reply library (default). 'ai' = Gemini; update privacy and terms pages first
AI_DRAFTS_POLICY_ACK=            # must be 'policy-updated' for AI mode to switch on; set only after the privacy and terms pages are changed
GEMINI_API_KEY=                  # only used when DRAFTS_MODE=ai; paid-tier key (billing enabled)
GEMINI_MODEL=gemini-2.5-flash-lite
GBP_NOTIFY_TOKEN=                # secret in the Pub/Sub push URL (?token=): 32+ characters; it can appear in platform logs, so rotate it
GBP_NOTIFY_TOKEN_PREVIOUS=       # optional: the old token, accepted during a rotation
GBP_NOTIFY_TOPIC=                # projects/<project>/topics/<topic> that Google publishes review notifications to
VAPID_PUBLIC_KEY=                # web push for new reviews: npx web-push generate-vapid-keys. Unset = push is off
VAPID_PRIVATE_KEY=               # secret half of the pair; never expose it to the browser
VAPID_SUBJECT=                   # mailto:you@domain or https URL that identifies the sender to push services
RAZORPAY_KEY_ID=                 # billing: Razorpay API key id (rzp_test_... until live). Unset = subscribe answers 503 BILLING_NOT_CONFIGURED
RAZORPAY_KEY_SECRET=             # secret half; server only
RAZORPAY_PLAN_ID=                # the monthly plan from the Razorpay dashboard. Razorpay charges exactly the plan amount and adds no GST itself, so for 'Rs 799 + 18% GST' create the plan at 942.82 (94282 paise). settings priceInr (799) is only shown; a plan matching neither 799 nor 799+GST logs a warning at checkout
RAZORPAY_WEBHOOK_SECRET=         # 16+ characters; the same value set on the webhook at Razorpay (POST /api/v1/internal/razorpay-webhook, subscription.* events)
